#!/bin/sh
# new-exercise — stamp a concept-exercise skeleton from spec.org's §2 parameters.
#
# Bootstraps a new source→derivation→view exercise repo: copies the
# problem-INDEPENDENT machinery verbatim (the generic gate, the .meta
# disciplines, spec.org, .gitignore) and templates the problem-SPECIFIC files
# (README.org with the §2 parameter table pre-filled, CLAUDE.md, layout dirs).
# Then follow spec.org §8 to fill it in.
#
# Usage:
#   bin/new-exercise -d <target-dir> [-n <name>] [--concept "..."] \
#       [--structure "..."] [--vocab "a,b,c"] [--languages "x,y,z"] [--force]
#
# Example:
#   bin/new-exercise -d ~/ghq/github.com/aygp-dr/sheet-recalc -n sheet-recalc \
#     --concept "spreadsheet; source=cells+formulas, derivation=recalc, view=values grid" \
#     --structure "dependency DAG over cells (a poset)" \
#     --vocab "reactive,build-systems,incremental,dependency-resolution,lazy-eval,order-theory" \
#     --languages "typescript,make,haskell,sql,racket,rust"
set -eu

SELF=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)   # reference repo root (source of the machinery)

DIR=""; NAME=""; CONCEPT=""; STRUCTURE=""; VOCAB=""; LANGUAGES=""; FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    -d) DIR="$2"; shift 2 ;;
    -n) NAME="$2"; shift 2 ;;
    --concept)   CONCEPT="$2"; shift 2 ;;
    --structure) STRUCTURE="$2"; shift 2 ;;
    --vocab)     VOCAB="$2"; shift 2 ;;
    --languages) LANGUAGES="$2"; shift 2 ;;
    --force) FORCE=1; shift ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
[ -n "$DIR" ] || { echo "FATAL: -d <target-dir> required (see --help)" >&2; exit 2; }
[ -n "$NAME" ] || NAME=$(basename "$DIR")
[ -n "$CONCEPT" ]   || CONCEPT="TODO: one line — source / derivation / view names"
[ -n "$STRUCTURE" ] || STRUCTURE="TODO: chain | poset | DAG | lattice"
[ -n "$VOCAB" ]     || VOCAB="TODO,TODO,TODO"
[ -n "$LANGUAGES" ] || LANGUAGES="TODO,TODO,TODO"

if [ -e "$DIR" ] && [ -n "$(ls -A "$DIR" 2>/dev/null)" ] && [ "$FORCE" -ne 1 ]; then
  echo "FATAL: $DIR exists and is non-empty (use --force to proceed)" >&2; exit 1
fi

mkdir -p "$DIR"/data/broken "$DIR"/data/trace "$DIR"/examples \
         "$DIR"/bin "$DIR"/.meta "$DIR"/experiments "$DIR"/assets

# --- problem-independent machinery, copied verbatim (deleted ceremony: reuse) ---
cp "$SELF/bin/verify.sh"           "$DIR/bin/verify.sh"
cp "$SELF/spec.org"                "$DIR/spec.org"
cp "$SELF/.meta/methodology.org"   "$DIR/.meta/methodology.org"
cp "$SELF/.meta/vocabulary.org"    "$DIR/.meta/vocabulary.org"
chmod +x "$DIR/bin/verify.sh"

# --- .gitignore ---
cat > "$DIR/.gitignore" <<'EOF'
# generated by the derivation (re-materialized on every run; not source of truth)
data/rebuilt/
# toolchain debris
erl_crash.dump
*.hi
*.o
.scala-build/
.stderr
*.stderr
EOF

# --- oracle contract placeholder (pin it from the reference run per spec §8.4) ---
cat > "$DIR/examples/oracle-contract.txt" <<'EOF'
== TODO section 1 ==
== TODO section 2 ==
== TODO section 3 ==
EOF

# --- README stub: house header + §2 parameter table pre-filled + skeleton ---
# build a vocabulary bullet list from --vocab
VOCAB_ROWS=$(printf '%s' "$VOCAB" | tr ',' '\n' | sed 's/^/- /')
cat > "$DIR/README.org" <<EOF
#+TITLE: $NAME
#+SUBTITLE: TODO one line — one problem, N vocabularies, N languages
#+AUTHOR: Aidan Pace
#+OPTIONS: toc:2 num:nil ^:nil
#+PROPERTY: header-args :mkdirp t
#+STARTUP: overview

[[./bin/verify.sh][https://img.shields.io/badge/verify-0%2F0_pending-lightgrey.svg]]
[[./spec.org][https://img.shields.io/badge/spec-v1.1.0-blue.svg]]
[[./.meta][https://img.shields.io/badge/method-spec--driven_%C2%B7_EDD-77aa99.svg]]

TODO lead paragraph. Instantiated from [[./spec.org][=spec.org=]]; fill the parameter
table below, then follow spec §8.

* Parameters (spec.org §2)

| param        | value |
|--------------+-------|
| =CONCEPT=    | $CONCEPT |
| =STRUCTURE S=| $STRUCTURE |
| =VOCABULARIES=| $VOCAB |
| =INVARIANTS= | TODO: schema (domain/arity/key) + structure (from S) + one unobservable |
| =DEFECTS=    | TODO: one per invariant + controls; classify (rebuild-curable/irreducible/anti-signal) |
| =LANGUAGES=  | $LANGUAGES |
| =ORACLE=     | =examples/oracle-contract.txt= (pin from the reference run) |

* Vocabularies

$VOCAB_ROWS

* How to use this document

TODO: Part 1 (candidate-facing broken view), Part 2 (backtrack to source),
Part 3 (rebuild), Part 4 (corrected view), Part 5 (refutation condition),
Rubric. See the reference exercise for the shape.
EOF

# --- CLAUDE.md stub ---
cat > "$DIR/CLAUDE.md" <<EOF
# CLAUDE.md — $NAME

## What Is This

A concept-exercise instantiated from \`spec.org\` (source→derivation→view).
\`README.org\` is the canonical spec; \`.meta/\` holds the operating disciplines.

## Quick Reference

| command | does |
|---|---|
| \`bin/verify.sh\` | run all examples, diff each against \`examples/oracle-contract.txt\` |
| \`bin/verify.sh examples/<tag>-<lang>\` | verify one example |

## Build & Test

\`\`\`sh
bin/verify.sh          # expect PASS=N once examples exist
\`\`\`

## Conventions

- Spec-governs (\`README.org\`); one editable representation (shared fixtures in
  \`data/\`); oracle-first + verify-the-verifier; re-tell not port; EDD; PCP.
  See \`spec.org\` and \`.meta/\`.

## What NOT to Do

- Do not edit fixtures or \`examples/oracle-contract.txt\` to pass a check.
- Do not add CI/Docker/linters; examples are single-file, stdlib-only.
EOF

# --- experiments seed ---
cat > "$DIR/experiments/README.org" <<'EOF'
#+TITLE: experiments
Speculative work lives here as NNN-slug/ with a falsifiable hypothesis,
success criterion, what-could-go-wrong, run command, and a promotion checklist.
See spec.org §7 and .meta/methodology.org.
EOF

echo "new-exercise: stamped $NAME at $DIR"
echo
echo "next (spec.org §8):"
echo "  1. cd $DIR && git init"
echo "  2. fill README.org §2 parameters; write Part 1 (the broken view)"
echo "  3. tangle fixtures into data/ (inject one defect per invariant + controls)"
echo "  4. build the reference example, RUN it -> pin examples/oracle-contract.txt"
echo "  5. bin/verify.sh  (negative-test it first)"
echo "  6. fan out the remaining languages; re-verify centrally"
